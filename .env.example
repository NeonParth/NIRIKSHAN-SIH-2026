# Copy to .env and fill in local values. Never commit .env.

POSTGRES_DB=nirikshan
POSTGRES_USER=nirikshan
POSTGRES_PASSWORD=change-me-in-local-env

# SQLAlchemy URL (psycopg3)
DATABASE_URL=postgresql+psycopg://nirikshan:change-me-in-local-env@localhost:5432/nirikshan

# Comma-separated browser origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional override for risk weight YAML
RISK_WEIGHTS_PATH=config/risk_weights.yaml

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:8000
